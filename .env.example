# Copy this file to .env only when you need to override a default.
LOCALSTACK_VERSION=latest
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0
LOCALSTACK_AUTH_TOKEN=

AWS_REGION=ap-northeast-2
