BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_DATA_SOURCE_ID=

S3_BUCKET=axsentinel-local
SQS_QUEUE=axsentinel-events
SNS_TOPIC=axsentinel-alerts
DYNAMODB_TABLE=axsentinel-domain
SECRET_NAME=axsentinel/local
